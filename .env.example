# 이 파일을 복사해서 .env로 만들어 사용하세요. (.env는 git에 올라가지 않음)

# =============================================================================
# 공통 - 검사대 장비 인증 키 (서버와 검사대가 같은 값을 써야 함)
# =============================================================================
DEVICE_SECRET=edge-secret-key-1234

# =============================================================================
# Backend Server (docker compose)
# =============================================================================
POSTGRES_USER=rentaly
POSTGRES_PASSWORD=change-me
POSTGRES_DB=rentaly
JWT_SECRET_KEY=super-secret-jwt-key-change-in-production

# =============================================================================
# Edge (Raspberry Pi) & FactChat
# =============================================================================
LLM_BASE_URL=https://factchat-cloud.mindlogic.ai/v1/gateway/chat/completions
LLM_API_KEY=your_mindlogic_api_key_here
LLM_MODEL=gemini-3.5-flash-lite

BACKEND_URL=https://rentaly.duckdns.org/api/v1/inspections
DEVICE_ID=station-01
MQTT_BROKER_HOST=rentaly.duckdns.org
MQTT_BROKER_PORT=1883
