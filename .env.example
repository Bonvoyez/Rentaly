# 이 파일을 복사해서 .env로 만들어 사용하세요. (.env는 git에 올라가지 않음)

# =============================================================================
# 공통 - 검사대 장비 인증 키 (서버와 검사대가 같은 값을 써야 함)
# =============================================================================
DEVICE_SECRET=edge-secret-key-1234

# =============================================================================
# Backend Server (docker compose)
# =============================================================================
POSTGRES_USER=rentaly
POSTGRES_PASSWORD=change-me
POSTGRES_DB=rentaly
JWT_SECRET_KEY=super-secret-jwt-key-change-in-production

# =============================================================================
# Edge AI / VLM (OpenAI 호환 API: OpenAI, Gemini, Ollama, vLLM 등 모두 지원)
# =============================================================================
LLM_BASE_URL=https://api.openai.com/v1/chat/completions
LLM_API_KEY=your_api_key_here
LLM_MODEL=gpt-4o-mini

# 백엔드 DB 연동 (비워두면 로컬 단독 모드로 동작)
BACKEND_URL=
DEVICE_ID=station-01
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883

# 카메라 없이 단일 이미지 파일로 테스트할 때 경로 지정 (선택)
# TEST_IMAGE_PATH=sample_data/training/IMG_8187.png
